# ===========================
# Test Environment Selection
# ===========================
# Allowed values: dev, qa, uat, ci
TEST_ENV=qa

# ===========================
# UI Credentials (Same for All Environments)
# ===========================
UI_USERNAME=common_ui_user
UI_PASSWORD=common_ui_password

# ===========================
# MongoDB URLs (Simple Version)
# ===========================

DEV_MONGODB_URL=mongodb://dev_db_user:dev_db_password@dev-db.company.com:27017/cap-service
QA_MONGODB_URL=mongodb://qa_db_user:qa_db_password@qa-db.company.com:27017/cap-service
UAT_MONGODB_URL=mongodb://uat_db_user:uat_db_password@uat-db.company.com:27017/cap-service
CI_MONGODB_URL=mongodb://ci_db_user:ci_db_password@ci-db.company.com:27017/cap-service

# ===========================
# Environment URLs
# ===========================

# DEV
